#!/usr/bin/env python3
"""
KeyRec — hotkey-toggled microphone *and* camera recorder for Linux/GNOME.

Two independent hotkeys toggle two independent recorders:

  * Ctrl+Alt+6  → microphone audio recording
  * Ctrl+Alt+7  → camera video recording (with audio, by default)

Each toggle starts/stops on its own; they can run at the same time. Both draw
their audio from one shared block of microphone settings (source, channels,
sample rate, volume), applied as a per-stream software gain — so running both at
once never changes your real device level and the two never interfere.

While the microphone is capturing, KeyRec hides GNOME's top-bar microphone
indicator (stealth mode). NOTE: the camera's physical activity LED is wired to
the sensor in hardware and cannot be turned off in software — video recording
will light it. See docs/HOW-IT-WORKS.md.

This single file is both the daemon (`keyrec daemon`, run by systemd) and the
command-line client (`keyrec toggle [audio|video]`, `keyrec status`, ...).
"""

from __future__ import annotations

import argparse
import datetime as dt
import glob
import json
import os
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time

VERSION = "1.2.0"

# ---------------------------------------------------------------------------
# Paths & defaults
# ---------------------------------------------------------------------------

# The control socket + runtime state live in a system runtime dir created by
# systemd (RuntimeDirectory=keyrec). Overridable for local testing.
RUNTIME_DIR = os.environ.get("KEYREC_RUNTIME_DIR", "/run/keyrec")
SOCK_PATH = os.environ.get("KEYREC_SOCK", os.path.join(RUNTIME_DIR, "keyrec.sock"))
STATE_PATH = os.environ.get("KEYREC_STATE", os.path.join(RUNTIME_DIR, "state.json"))
# Each recorder's ffmpeg stderr is redirected to its own file (not a pipe) so a
# long recording can never stall on a full pipe buffer, and so start-failures
# can be read back. Derived from a base path (env-overridable).
FFMPEG_LOG = os.environ.get("KEYREC_FFMPEG_LOG", os.path.join(RUNTIME_DIR, "ffmpeg.log"))


def _ffmpeg_log(kind):
    """Per-recorder ffmpeg log path, e.g. .../ffmpeg-audio.log."""
    base, ext = os.path.splitext(FFMPEG_LOG)
    return f"{base}-{kind}{ext or '.log'}"


SYSTEM_CONFIG = os.environ.get("KEYREC_SYSTEM_CONFIG", "/etc/keyrec/config.toml")
USER_CONFIG = os.environ.get(
    "KEYREC_USER_CONFIG",
    os.path.join(
        os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
        "keyrec",
        "config.toml",
    ),
)

# The command keyd will run (as root) when a hotkey is pressed. It re-enters
# this program as a thin client that pokes the daemon over the socket.
INSTALL_PATH = os.environ.get("KEYREC_BIN", "/usr/local/bin/keyrec")


def _toggle_cmd(target):
    return f"{INSTALL_PATH} toggle {target} --source=hotkey"


# keyd wiring. The hotkeys are installed as a single *include payload* (a file
# with no extension, per keyd's rules) that is pulled into the keyd configs
# which own your keyboards via an `include keyrec` line. This is
# non-destructive: it never competes for devices the way a second `[ids] *`
# config would.
KEYD_DIR = os.environ.get("KEYREC_KEYD_DIR", "/etc/keyd")
KEYD_INCLUDE_NAME = "keyrec"
KEYD_INCLUDE_FILE = os.path.join(KEYD_DIR, KEYD_INCLUDE_NAME)

# Friendly modifier names -> keyd layer tokens.
MODIFIER_ALIASES = {
    "ctrl": "control", "control": "control",
    "alt": "alt", "option": "alt", "opt": "alt",
    "shift": "shift",
    "super": "meta", "win": "meta", "cmd": "meta", "meta": "meta", "mod4": "meta",
    "altgr": "altgr", "ralt": "altgr",
}

DEFAULT_CONFIG = {
    "output_dir": "~/Documents/Recordings",

    # --- shared microphone settings (used by BOTH audio and video recorders) -
    # These describe the one microphone. Both recorders read from the same
    # source with these settings; the volume is applied as a per-stream
    # software gain, so the real device level is never touched and two
    # simultaneous captures never interfere with each other.
    "source": "default",         # pulse/pipewire source name, or "default"
    "channels": 1,               # 1 = mono, 2 = stereo
    "samplerate": 48000,
    "mic_volume": 100,           # percent gain applied to captured audio (100 = unchanged)

    # --- audio recording ----------------------------------------------------
    "format": "opus",            # opus | vorbis | mp3 | aac | flac | wav
    "bitrate": "48k",            # used by lossy formats (opus/mp3/aac)
    "hotkey": "control+alt+6",   # keyd binding syntax — toggles audio recording

    # --- video recording ----------------------------------------------------
    "camera": "default",         # v4l2 device path, or "default" (first /dev/video*)
    "video_format": "mp4",       # mp4 | mkv | webm
    "video_resolution": "default",   # WxH (e.g. 1280x720) or "default" (camera picks)
    "video_framerate": "default",    # fps (e.g. 30) or "default"
    "video_bitrate": "4M",       # target video bitrate
    "video_audio": True,         # include the microphone in the video (mute with false)
    "video_hotkey": "control+alt+7",  # keyd binding syntax — toggles video recording

    # --- shared behaviour ---------------------------------------------------
    "filename_prefix": "keyrec",
    "stealth": True,             # hide the GNOME microphone indicator (audio only)
    "stealth_app_id": "org.gnome.VolumeControl",
    "notify": True,              # desktop notification on start/stop
}

# audio format -> (ffmpeg audio-codec args, file extension)
FORMATS = {
    "opus":   (["-c:a", "libopus"], ".opus"),
    "vorbis": (["-c:a", "libvorbis", "-q:a", "5"], ".ogg"),
    "mp3":    (["-c:a", "libmp3lame"], ".mp3"),
    "aac":    (["-c:a", "aac"], ".m4a"),
    "flac":   (["-c:a", "flac"], ".flac"),
    "wav":    (["-c:a", "pcm_s16le"], ".wav"),
}
LOSSY = {"opus", "mp3", "aac"}

# video format -> (video-codec args, audio-codec args, extension)
VIDEO_FORMATS = {
    "mp4":  (["-c:v", "libx264", "-preset", "veryfast", "-pix_fmt", "yuv420p"],
             ["-c:a", "aac", "-b:a", "128k"], ".mp4"),
    "mkv":  (["-c:v", "libx264", "-preset", "veryfast", "-pix_fmt", "yuv420p"],
             ["-c:a", "aac", "-b:a", "128k"], ".mkv"),
    "webm": (["-c:v", "libvpx-vp9", "-deadline", "realtime", "-cpu-used", "5"],
             ["-c:a", "libopus", "-b:a", "128k"], ".webm"),
}


# ---------------------------------------------------------------------------
# Minimal flat-TOML read/write (no third-party deps, works on any Python 3.6+)
# Our config is a flat table of scalars, so we don't need a full TOML parser.
# ---------------------------------------------------------------------------

def _toml_load(path):
    data = {}
    try:
        with open(path, "r", encoding="utf-8") as fh:
            lines = fh.readlines()
    except FileNotFoundError:
        return data
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#") or line.startswith("["):
            continue
        if "=" not in line:
            continue
        key, _, val = line.partition("=")
        key = key.strip()
        val = val.split(" #", 1)[0].strip()  # strip trailing comments
        if not key:
            continue
        data[key] = _toml_value(val)
    return data


def _toml_value(val):
    if (val.startswith('"') and val.endswith('"')) or (
        val.startswith("'") and val.endswith("'")
    ):
        return val[1:-1]
    low = val.lower()
    if low == "true":
        return True
    if low == "false":
        return False
    try:
        return int(val)
    except ValueError:
        pass
    try:
        return float(val)
    except ValueError:
        pass
    return val


def _toml_dump(data, header=None):
    out = []
    if header:
        out.append(header.rstrip() + "\n\n")
    for key, val in data.items():
        if isinstance(val, bool):
            sval = "true" if val else "false"
        elif isinstance(val, (int, float)):
            sval = str(val)
        else:
            sval = '"' + str(val).replace('"', '\\"') + '"'
        out.append(f"{key} = {sval}\n")
    return "".join(out)


# ---------------------------------------------------------------------------
# Config helpers
# ---------------------------------------------------------------------------

def load_config():
    """Effective config = defaults < /etc/keyrec < ~/.config/keyrec."""
    cfg = dict(DEFAULT_CONFIG)
    cfg.update(_toml_load(SYSTEM_CONFIG))
    cfg.update(_toml_load(USER_CONFIG))
    # keep only known keys, coerced to the default's type where possible
    clean = {}
    for key, default in DEFAULT_CONFIG.items():
        val = cfg.get(key, default)
        if isinstance(default, bool):
            val = val if isinstance(val, bool) else str(val).lower() in ("1", "true", "yes", "on")
        elif isinstance(default, int) and not isinstance(val, bool):
            try:
                val = int(val)
            except (ValueError, TypeError):
                val = default
        clean[key] = val
    return clean


def save_user_config(cfg):
    """Persist the given config as the user override file."""
    d = os.path.dirname(USER_CONFIG)
    os.makedirs(d, exist_ok=True)
    header = "# KeyRec user configuration (overrides /etc/keyrec/config.toml)\n" \
             "# Written by `keyrec config set`. Safe to hand-edit."
    tmp = USER_CONFIG + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(_toml_dump(cfg, header))
    os.replace(tmp, USER_CONFIG)


def expand_output_dir(cfg):
    return os.path.abspath(os.path.expanduser(str(cfg["output_dir"])))


def resolve_camera(cfg):
    """Turn the `camera` setting into a concrete /dev/video* device path."""
    cam = str(cfg.get("camera", "default") or "default").strip()
    if cam and cam != "default":
        return cam
    devs = sorted(glob.glob("/dev/video*"),
                  key=lambda p: int(re.sub(r"\D", "", os.path.basename(p)) or 0))
    return devs[0] if devs else "/dev/video0"


# ---------------------------------------------------------------------------
# Hotkey -> keyd include payload
# ---------------------------------------------------------------------------

def parse_hotkey(hotkey):
    """'control+alt+6' -> ('control+alt', '6').  'f9' -> ('main', 'f9')."""
    parts = [p.strip().lower() for p in str(hotkey).split("+") if p.strip()]
    if not parts:
        raise ValueError("empty hotkey")
    key = parts[-1]
    mods = []
    for m in parts[:-1]:
        norm = MODIFIER_ALIASES.get(m)
        if not norm:
            raise ValueError(f"unknown modifier {m!r} in hotkey {hotkey!r}")
        if norm not in mods:
            mods.append(norm)
    layer = "+".join(mods) if mods else "main"
    return layer, key


def render_keyd_include(bindings):
    """Render one keyd include payload for a list of (hotkey, command) pairs.

    Keys that share the same modifier layer are grouped into one block, which
    is what keyd expects (two `[control+alt]` blocks would be redundant).
    """
    layers = {}   # layer -> list of (key, command), preserving order
    order = []
    notes = []
    for hotkey, cmd in bindings:
        layer, key = parse_hotkey(hotkey)
        if layer not in layers:
            layers[layer] = []
            order.append(layer)
        layers[layer].append((key, cmd))
        notes.append(f"#   {hotkey} runs: {cmd}")
    out = ["# Generated by `keyrec apply-hotkey` — do not edit by hand."]
    out.extend(notes)
    for layer in order:
        out.append(f"[{layer}]")
        for key, cmd in layers[layer]:
            out.append(f"{key} = command({cmd})")
    return "\n".join(out) + "\n"


def _keyd_conf_files():
    try:
        names = sorted(os.listdir(KEYD_DIR))
    except OSError:
        return []
    return [os.path.join(KEYD_DIR, n) for n in names if n.endswith(".conf")]


def _file_has_ids(path):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            for line in fh:
                if line.strip() == "[ids]":
                    return True
    except OSError:
        pass
    return False


def _insert_include(path):
    """Add `include keyrec` after the first [ids] block. Returns a status str."""
    try:
        with open(path, "r", encoding="utf-8") as fh:
            lines = fh.read().split("\n")
    except OSError as exc:
        return f"error: {exc}"
    directive = f"include {KEYD_INCLUDE_NAME}"
    if any(l.strip() == directive for l in lines):
        return "already"
    try:
        idx = next(i for i, l in enumerate(lines) if l.strip() == "[ids]")
    except StopIteration:
        return "no-ids"
    j = idx + 1
    while j < len(lines) and lines[j].strip() and not lines[j].strip().startswith("["):
        j += 1
    # back up once
    bak = path + ".keyrec-bak"
    if not os.path.exists(bak):
        try:
            shutil.copy2(path, bak)
        except OSError:
            pass
    lines.insert(j, directive)
    try:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write("\n".join(lines))
    except OSError as exc:
        return f"error: {exc}"
    return "added"


def _remove_include(path):
    directive = f"include {KEYD_INCLUDE_NAME}"
    try:
        with open(path, "r", encoding="utf-8") as fh:
            lines = fh.read().split("\n")
    except OSError:
        return "skip"
    new = [l for l in lines if l.strip() != directive]
    if len(new) == len(lines):
        return "absent"
    try:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write("\n".join(new))
    except OSError as exc:
        return f"error: {exc}"
    return "removed"


def _keyd_reload():
    if which("keyd"):
        try:
            subprocess.run(["keyd", "reload"], capture_output=True, timeout=5)
        except Exception:
            pass


# ---------------------------------------------------------------------------
# Small utilities
# ---------------------------------------------------------------------------

def which(name):
    return shutil.which(name)


def _read_text(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def human_duration(seconds):
    seconds = int(seconds)
    h, rem = divmod(seconds, 3600)
    m, s = divmod(rem, 60)
    if h:
        return f"{h}:{m:02d}:{s:02d}"
    return f"{m:02d}:{s:02d}"


def log(msg):
    ts = dt.datetime.now().strftime("%H:%M:%S")
    print(f"[keyrec {ts}] {msg}", flush=True)


# ---------------------------------------------------------------------------
# Recorder — one independent capture (audio or video)
# ---------------------------------------------------------------------------

class Recorder:
    """A single toggleable capture. Two of these (audio + video) live inside
    the daemon and run completely independently of each other."""

    def __init__(self, daemon, kind):
        self.daemon = daemon          # for cfg + notify
        self.kind = kind              # "audio" | "video"
        self.lock = threading.RLock()
        self.proc = None              # ffmpeg subprocess.Popen while recording
        self.current_file = None
        self.started_at = None
        self.ffmpeg_log = _ffmpeg_log(kind)

    @property
    def cfg(self):
        return self.daemon.cfg

    # -- state ------------------------------------------------------------
    def is_recording(self):
        return self.proc is not None and self.proc.poll() is None

    def state_dict(self):
        rec = self.is_recording()
        elapsed = (time.time() - self.started_at) if (rec and self.started_at) else 0
        return {
            "recording": rec,
            "file": self.current_file if rec else None,
            "started_at": self.started_at if rec else None,
            "elapsed": round(elapsed, 1),
            "elapsed_human": human_duration(elapsed) if rec else "00:00",
            "pid": self.proc.pid if rec else None,
        }

    # -- shared audio input ----------------------------------------------
    def _audio_input_args(self):
        """The pulse input flags shared by both recorders."""
        return ["-f", "pulse", "-name", "KeyRec",
                "-i", str(self.cfg["source"] or "default")]

    def _mic_gain_filter(self):
        """Software gain from mic_volume (percent). None when it's 100/off."""
        try:
            vol = int(self.cfg.get("mic_volume", 100))
        except (TypeError, ValueError):
            vol = 100
        if vol == 100:
            return None
        return f"volume={max(vol, 0) / 100.0:.4f}"

    # -- ffmpeg command per kind -----------------------------------------
    def build_cmd(self, outfile):
        return (self._build_audio_cmd if self.kind == "audio"
                else self._build_video_cmd)(outfile)

    def _build_audio_cmd(self, outfile):
        cfg = self.cfg
        fmt = cfg["format"]
        codec_args, _ext = FORMATS.get(fmt, FORMATS["opus"])
        cmd = [which("ffmpeg") or "ffmpeg",
               "-hide_banner", "-loglevel", "warning", "-nostdin", "-y"]
        cmd += self._audio_input_args()
        cmd += ["-ac", str(cfg["channels"]), "-ar", str(cfg["samplerate"])]
        gain = self._mic_gain_filter()
        if gain:
            cmd += ["-af", gain]
        cmd += codec_args
        if fmt in LOSSY:
            cmd += ["-b:a", str(cfg["bitrate"])]
        cmd += [outfile]
        return cmd

    def _build_video_cmd(self, outfile):
        cfg = self.cfg
        fmt = cfg["video_format"]
        vcodec, acodec, _ext = VIDEO_FORMATS.get(fmt, VIDEO_FORMATS["mp4"])
        cam = resolve_camera(cfg)
        with_audio = bool(cfg.get("video_audio", True))

        cmd = [which("ffmpeg") or "ffmpeg",
               "-hide_banner", "-loglevel", "warning", "-nostdin", "-y"]

        # --- camera (video) input; input options must precede the -i ---
        res = str(cfg.get("video_resolution", "default") or "default").strip()
        if res and res != "default":
            cmd += ["-video_size", res]
        fps = str(cfg.get("video_framerate", "default") or "default").strip()
        if fps and fps != "default":
            cmd += ["-framerate", fps]
        cmd += ["-f", "v4l2", "-i", cam]

        # --- microphone (audio) input, shared settings ---
        if with_audio:
            cmd += self._audio_input_args()
            cmd += ["-ac", str(cfg["channels"]), "-ar", str(cfg["samplerate"])]
            # Explicit mapping so ffmpeg pairs camera video with mic audio.
            cmd += ["-map", "0:v:0", "-map", "1:a:0"]
            gain = self._mic_gain_filter()
            if gain:
                cmd += ["-af", gain]
        else:
            cmd += ["-map", "0:v:0"]

        cmd += vcodec
        if str(cfg.get("video_bitrate", "")).strip():
            cmd += ["-b:v", str(cfg["video_bitrate"])]
        if with_audio:
            cmd += acodec
        cmd += [outfile]
        return cmd

    # -- child environment (stealth) -------------------------------------
    def _child_env(self):
        env = dict(os.environ)
        # Stealth hides GNOME's *microphone* icon by stamping application.id
        # onto our capture stream. It applies to any recorder that opens the
        # mic (audio always; video when it includes audio). It cannot hide the
        # camera's hardware LED.
        opens_mic = self.kind == "audio" or bool(self.cfg.get("video_audio", True))
        if self.cfg["stealth"] and opens_mic:
            env["PULSE_PROP"] = f"application.id={self.cfg['stealth_app_id']}"
        return env

    def _outfile(self):
        outdir = expand_output_dir(self.cfg)
        os.makedirs(outdir, exist_ok=True)
        if self.kind == "audio":
            ext = FORMATS.get(self.cfg["format"], FORMATS["opus"])[1]
            tag = ""
        else:
            ext = VIDEO_FORMATS.get(self.cfg["video_format"], VIDEO_FORMATS["mp4"])[2]
            tag = "_video"
        stamp = dt.datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
        name = f"{self.cfg['filename_prefix']}{tag}_{stamp}{ext}"
        return os.path.join(outdir, name)

    # -- lifecycle --------------------------------------------------------
    def start(self):
        with self.lock:
            if self.is_recording():
                return {"ok": True, "already": True, "target": self.kind,
                        **self.state_dict()}
            outdir = expand_output_dir(self.cfg)
            try:
                os.makedirs(outdir, exist_ok=True)
            except OSError as exc:
                return {"ok": False, "target": self.kind,
                        "error": f"cannot create output dir {outdir}: {exc}"}
            outfile = self._outfile()
            cmd = self.build_cmd(outfile)
            # Redirect ffmpeg's stderr to a file (not a pipe): a pipe we never
            # drain would eventually fill and stall a long recording.
            try:
                log_fh = open(self.ffmpeg_log, "wb")
            except OSError:
                log_fh = subprocess.DEVNULL
            try:
                proc = subprocess.Popen(
                    cmd,
                    env=self._child_env(),
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=log_fh,
                    start_new_session=True,
                )
            except OSError as exc:
                if hasattr(log_fh, "close"):
                    try:
                        log_fh.close()
                    except OSError:
                        pass
                return {"ok": False, "target": self.kind,
                        "error": f"failed to launch ffmpeg: {exc}"}
            if hasattr(log_fh, "close"):
                # ffmpeg holds its own dup of the fd; drop the parent's copy.
                try:
                    log_fh.close()
                except OSError:
                    pass

            # Commit state and return immediately — no blocking wait. This is
            # what makes the hotkey feel instant. A watcher thread surfaces the
            # rare case where ffmpeg dies right after launch.
            self.proc = proc
            self.current_file = outfile
            self.started_at = time.time()
            self.daemon.persist_state()
            state = self.state_dict()

        if self.kind == "audio":
            log(f"audio recording -> {outfile} "
                f"(stealth={'on' if self.cfg['stealth'] else 'off'})")
            self.daemon.notify("🔴 KeyRec — recording", os.path.basename(outfile),
                               icon="audio-input-microphone-symbolic")
        else:
            aud = "with audio" if self.cfg.get("video_audio", True) else "muted"
            log(f"video recording -> {outfile} "
                f"(camera={resolve_camera(self.cfg)}, {aud})")
            self.daemon.notify("🎥 KeyRec — recording video",
                               os.path.basename(outfile) + "  ·  camera LED is on",
                               icon="camera-web-symbolic")
        threading.Thread(target=self._watch_start, args=(proc, outfile),
                         daemon=True).start()
        return {"ok": True, "target": self.kind, **state}

    def _watch_start(self, proc, outfile):
        """Async fail-fast: if ffmpeg exits on its own shortly after launch,
        clear the state and tell the user. A user-initiated stop detaches
        ``self.proc`` first, so this stays silent for normal stops."""
        try:
            rc = proc.wait(timeout=1.0)
        except subprocess.TimeoutExpired:
            return  # healthy — still capturing
        with self.lock:
            if self.proc is not proc:
                return  # someone already stopped it; the exit was intentional
            self.proc = None
            self.current_file = None
            self.started_at = None
            self.daemon.persist_state()
        err = _read_text(self.ffmpeg_log)
        detail = (err.splitlines()[-1] if err else f"ffmpeg exited (rc={rc})")[:140]
        log(f"{self.kind} ffmpeg exited immediately (rc={rc}): {err[-500:]}")
        self.daemon.notify(f"⚠ KeyRec — couldn’t record {self.kind}", detail)

    def stop(self):
        with self.lock:
            if not self.is_recording():
                return {"ok": True, "already_idle": True, "target": self.kind,
                        **self.state_dict()}
            proc = self.proc
            outfile = self.current_file
            started = self.started_at
            # Detach from shared state *before* signalling, so a re-toggle is
            # instant and _watch_start treats this exit as intentional.
            self.proc = None
            self.current_file = None
            self.started_at = None
            self.daemon.persist_state()
            state = self.state_dict()

        # SIGINT lets ffmpeg finalize the container (write the trailer). The
        # signal is instant; the flush + "saved" notice happen in the
        # background so the toggle returns right away.
        try:
            proc.send_signal(signal.SIGINT)
        except ProcessLookupError:
            pass
        elapsed = time.time() - (started or time.time())
        dur = human_duration(elapsed)
        threading.Thread(target=self._finalize, args=(proc, outfile, elapsed, dur),
                         daemon=True).start()
        return {"ok": True, "target": self.kind, "file": outfile, "stopping": True,
                "duration": round(elapsed, 1), "duration_human": dur, **state}

    def _finalize(self, proc, outfile, elapsed, dur):
        """Wait for ffmpeg to flush, then report the saved file (async)."""
        try:
            proc.wait(timeout=8)
        except subprocess.TimeoutExpired:
            log(f"{self.kind} ffmpeg slow to finalize; sending SIGTERM")
            try:
                proc.terminate()
                proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                log(f"{self.kind} ffmpeg unresponsive; killing")
                proc.kill()
        size = os.path.getsize(outfile) if outfile and os.path.exists(outfile) else 0
        log(f"saved {outfile} ({size} bytes, {dur})")
        label = "video" if self.kind == "video" else ""
        if size > 0:
            self.daemon.notify(f"⏹ KeyRec — {label} saved".replace("  ", " "),
                               f"{os.path.basename(outfile)}  ·  {dur}")
        else:
            self.daemon.notify(f"⚠ KeyRec — empty {self.kind} recording",
                               os.path.basename(outfile) if outfile else "")

    def toggle(self):
        if self.is_recording():
            return self.stop()
        return self.start()

    def force_stop_blocking(self):
        """Used on daemon shutdown: signal + wait so the file is flushed."""
        with self.lock:
            if not self.is_recording():
                return
            proc = self.proc
            outfile = self.current_file
            started = self.started_at
            self.proc = None
            self.current_file = None
            self.started_at = None
            self.daemon.persist_state()
        try:
            proc.send_signal(signal.SIGINT)
        except ProcessLookupError:
            pass
        elapsed = time.time() - (started or time.time())
        self._finalize(proc, outfile, elapsed, human_duration(elapsed))


# ---------------------------------------------------------------------------
# Daemon
# ---------------------------------------------------------------------------

class Daemon:
    def __init__(self):
        self.cfg = load_config()
        self.audio = Recorder(self, "audio")
        self.video = Recorder(self, "video")
        self._stop = threading.Event()
        self._sock = None

    def recorder(self, target):
        return self.video if target == "video" else self.audio

    # -- state ------------------------------------------------------------
    def state_dict(self):
        a = self.audio.state_dict()
        v = self.video.state_dict()
        return {
            "audio": a,
            "video": v,
            # convenience top-level "any recording?" flag
            "recording": a["recording"] or v["recording"],
            "output_dir": expand_output_dir(self.cfg),
            "format": self.cfg["format"],
            "video_format": self.cfg["video_format"],
            "camera": resolve_camera(self.cfg),
            "mic_volume": int(self.cfg.get("mic_volume", 100)),
            "video_audio": bool(self.cfg.get("video_audio", True)),
            "stealth": bool(self.cfg["stealth"]),
            "notify": bool(self.cfg["notify"]),
            "hotkey": self.cfg["hotkey"],
            "video_hotkey": self.cfg["video_hotkey"],
        }

    def persist_state(self):
        try:
            os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
            tmp = STATE_PATH + ".tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                json.dump(self.state_dict(), fh)
            os.replace(tmp, STATE_PATH)
        except OSError as exc:
            log(f"could not write state file: {exc}")

    # -- notifications ----------------------------------------------------
    def notify(self, title, body="", icon="audio-input-microphone-symbolic"):
        if not self.cfg["notify"]:
            return
        try:
            if which("notify-send"):
                subprocess.Popen(
                    ["notify-send", "-a", "KeyRec", "-i", icon, title, body],
                    stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
        except Exception as exc:
            log(f"notify failed: {exc}")

    # -- socket server ----------------------------------------------------
    def handle(self, req):
        cmd = req.get("cmd")
        target = req.get("target", "audio")
        if target not in ("audio", "video"):
            return {"ok": False, "error": f"unknown target: {target!r}"}
        if cmd == "ping":
            return {"ok": True, "version": VERSION}
        if cmd == "toggle":
            return {**self.recorder(target).toggle(), **self.state_dict()}
        if cmd == "start":
            return {**self.recorder(target).start(), **self.state_dict()}
        if cmd == "stop":
            return {**self.recorder(target).stop(), **self.state_dict()}
        if cmd == "status":
            return {"ok": True, **self.state_dict()}
        if cmd == "get-config":
            return {"ok": True, "config": self.cfg}
        if cmd == "set-config":
            return self.apply_config_changes(req.get("changes", {}))
        if cmd == "reload":
            self.cfg = load_config()
            self.persist_state()
            return {"ok": True, "config": self.cfg}
        return {"ok": False, "error": f"unknown command: {cmd!r}"}

    def apply_config_changes(self, changes):
        if not isinstance(changes, dict) or not changes:
            return {"ok": False, "error": "no changes given"}
        merged = dict(_toml_load(USER_CONFIG))  # existing overrides
        applied = {}
        for key, val in changes.items():
            if key not in DEFAULT_CONFIG:
                return {"ok": False, "error": f"unknown config key: {key}"}
            default = DEFAULT_CONFIG[key]
            if isinstance(default, bool):
                val = val if isinstance(val, bool) else str(val).lower() in ("1", "true", "yes", "on")
            elif isinstance(default, int) and not isinstance(val, bool):
                try:
                    val = int(val)
                except (ValueError, TypeError):
                    return {"ok": False, "error": f"{key} must be an integer"}
            if key == "format" and val not in FORMATS:
                return {"ok": False, "error": f"format must be one of {', '.join(FORMATS)}"}
            if key == "video_format" and val not in VIDEO_FORMATS:
                return {"ok": False, "error": f"video_format must be one of {', '.join(VIDEO_FORMATS)}"}
            if key == "mic_volume" and val < 0:
                return {"ok": False, "error": "mic_volume must be >= 0"}
            merged[key] = val
            applied[key] = val
        try:
            save_user_config(merged)
        except OSError as exc:
            return {"ok": False, "error": f"could not write {USER_CONFIG}: {exc}"}
        old_hotkeys = (self.cfg.get("hotkey"), self.cfg.get("video_hotkey"))
        self.cfg = load_config()
        self.persist_state()
        new_hotkeys = (self.cfg.get("hotkey"), self.cfg.get("video_hotkey"))
        return {"ok": True, "applied": applied,
                "hotkey_changed": new_hotkeys != old_hotkeys,
                "config": self.cfg}

    def serve(self):
        # Clean up a stale socket
        try:
            if os.path.exists(SOCK_PATH):
                os.unlink(SOCK_PATH)
        except OSError:
            pass
        os.makedirs(os.path.dirname(SOCK_PATH), exist_ok=True)
        self._sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self._sock.bind(SOCK_PATH)
        try:
            os.chmod(SOCK_PATH, 0o660)
        except OSError:
            pass
        self._sock.listen(8)
        self._sock.settimeout(1.0)
        log(f"listening on {SOCK_PATH}")

        while not self._stop.is_set():
            try:
                conn, _ = self._sock.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            with conn:
                try:
                    conn.settimeout(5)
                    buf = b""
                    while b"\n" not in buf:
                        chunk = conn.recv(4096)
                        if not chunk:
                            break
                        buf += chunk
                    line = buf.split(b"\n", 1)[0].decode("utf-8", "replace").strip()
                    req = json.loads(line) if line else {}
                    resp = self.handle(req)
                except json.JSONDecodeError:
                    resp = {"ok": False, "error": "invalid JSON request"}
                except Exception as exc:
                    resp = {"ok": False, "error": f"internal error: {exc}"}
                try:
                    conn.sendall((json.dumps(resp) + "\n").encode("utf-8"))
                except OSError:
                    pass

    # -- lifecycle --------------------------------------------------------
    def run(self):
        signal.signal(signal.SIGTERM, self._on_term)
        signal.signal(signal.SIGINT, self._on_term)
        signal.signal(signal.SIGUSR1, lambda *_: self.audio.toggle())
        signal.signal(signal.SIGUSR2, lambda *_: self.video.toggle())
        try:
            signal.signal(signal.SIGHUP, lambda *_: self._on_hup())
        except (ValueError, AttributeError):
            pass

        log(f"KeyRec daemon {VERSION} starting")
        self.persist_state()
        try:
            self.serve()
        finally:
            self.shutdown()

    def _on_hup(self):
        log("SIGHUP: reloading config")
        self.cfg = load_config()
        self.persist_state()

    def _on_term(self, *_):
        log("shutting down")
        self._stop.set()

    def shutdown(self):
        for rec in (self.audio, self.video):
            if rec.is_recording():
                log(f"stopping in-progress {rec.kind} recording before exit")
                rec.force_stop_blocking()
        try:
            if self._sock:
                self._sock.close()
        except OSError:
            pass
        try:
            if os.path.exists(SOCK_PATH):
                os.unlink(SOCK_PATH)
        except OSError:
            pass


# ---------------------------------------------------------------------------
# Client
# ---------------------------------------------------------------------------

class DaemonError(Exception):
    pass


def client_request(req, timeout=8):
    if not os.path.exists(SOCK_PATH):
        raise DaemonError(
            f"KeyRec daemon socket not found at {SOCK_PATH}.\n"
            "Is the service running?  Try:  systemctl status keyrec"
        )
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(SOCK_PATH)
    except (ConnectionRefusedError, FileNotFoundError, PermissionError) as exc:
        raise DaemonError(f"cannot reach KeyRec daemon: {exc}")
    try:
        s.sendall((json.dumps(req) + "\n").encode("utf-8"))
        buf = b""
        while b"\n" not in buf:
            chunk = s.recv(4096)
            if not chunk:
                break
            buf += chunk
    finally:
        s.close()
    line = buf.split(b"\n", 1)[0].decode("utf-8", "replace").strip()
    if not line:
        raise DaemonError("empty response from daemon")
    return json.loads(line)


# ---------------------------------------------------------------------------
# CLI command implementations
# ---------------------------------------------------------------------------

def cmd_daemon(args):
    Daemon().run()
    return 0


def _print_status(st, as_json=False):
    if as_json:
        print(json.dumps(st, indent=2))
        return
    a = st.get("audio", {})
    v = st.get("video", {})
    if a.get("recording"):
        print(f"\033[31m●\033[0m AUDIO recording   {a['elapsed_human']}")
        print(f"    file    : {a['file']}")
    else:
        print("\033[90m○\033[0m audio idle")
    if v.get("recording"):
        print(f"\033[31m●\033[0m VIDEO recording   {v['elapsed_human']}  \033[90m(camera LED on)\033[0m")
        print(f"    file    : {v['file']}")
    else:
        print("\033[90m○\033[0m video idle")
    print(f"    folder    : {st.get('output_dir')}")
    print(f"    audio fmt : {st.get('format')}")
    print(f"    video fmt : {st.get('video_format')}   camera: {st.get('camera')}")
    print(f"    mic vol   : {st.get('mic_volume')}%")
    print(f"    video mic : {'on (video has audio)' if st.get('video_audio', True) else 'muted'}")
    stealth = st.get("stealth")
    print(f"    stealth   : {'on  (GNOME mic icon hidden)' if stealth else 'off (mic icon shown)'}")
    print(f"    notify    : {'on' if st.get('notify', True) else 'off'}")
    print(f"    hotkeys   : audio {st.get('hotkey')}   video {st.get('video_hotkey')}")


def _toggle_like(cmd, args):
    resp = client_request({"cmd": cmd, "target": args.target})
    if not resp.get("ok"):
        print("error:", resp.get("error"), file=sys.stderr)
        return 1
    if not args.quiet:
        if cmd == "stop" and resp.get("file"):
            print(f"saved {resp['file']}  ({resp.get('duration_human', '')})")
        _print_status(resp)
    return 0


def cmd_toggle(args):
    return _toggle_like("toggle", args)


def cmd_start(args):
    return _toggle_like("start", args)


def cmd_stop(args):
    return _toggle_like("stop", args)


def cmd_status(args):
    try:
        resp = client_request({"cmd": "status"})
    except DaemonError as exc:
        # Fall back to the on-disk state file if the socket is unavailable
        if os.path.exists(STATE_PATH):
            try:
                with open(STATE_PATH) as fh:
                    st = json.load(fh)
                st["ok"] = True
                _print_status(st, args.json)
                return 0
            except (OSError, json.JSONDecodeError):
                pass
        print("error:", exc, file=sys.stderr)
        return 1
    _print_status(resp, args.json)
    return 0


def cmd_config(args):
    if args.config_action == "get":
        resp = client_request({"cmd": "get-config"})
        cfg = resp.get("config", {})
        if args.key:
            if args.key not in cfg:
                print(f"unknown key: {args.key}", file=sys.stderr)
                return 1
            print(cfg[args.key])
        else:
            for k, v in cfg.items():
                print(f"{k} = {v!r}")
        return 0

    if args.config_action == "set":
        val = _coerce_cli_value(args.value)
        resp = client_request({"cmd": "set-config", "changes": {args.key: val}})
        if not resp.get("ok"):
            print("error:", resp.get("error"), file=sys.stderr)
            return 1
        print(f"{args.key} = {resp['applied'][args.key]!r}")
        if args.key in ("hotkey", "video_hotkey") and resp.get("hotkey_changed"):
            self_path = os.environ.get("KEYREC_BIN") or os.path.abspath(sys.argv[0])
            print("activating the new hotkey (needs sudo)...")
            subprocess.run(["sudo", self_path, "apply-hotkey"])
        return 0

    if args.config_action == "path":
        return _pick_folder_and_set(use_gui=True)

    return 1


def _coerce_cli_value(val):
    low = val.lower()
    if low in ("true", "yes", "on"):
        return True
    if low in ("false", "no", "off"):
        return False
    try:
        return int(val)
    except ValueError:
        return val


def _pick_folder_and_set(use_gui):
    """Open a GUI folder picker (zenity) and set output_dir to the choice."""
    if not which("zenity"):
        print("zenity is not installed; set the folder with:\n"
              "  keyrec config set output_dir /path/to/folder", file=sys.stderr)
        return 1
    try:
        cur = client_request({"cmd": "get-config"}).get("config", {})
        start_dir = os.path.expanduser(str(cur.get("output_dir", "~")))
    except DaemonError:
        start_dir = os.path.expanduser("~")
    try:
        res = subprocess.run(
            ["zenity", "--file-selection", "--directory",
             "--title=KeyRec — choose recordings folder",
             f"--filename={start_dir}/"],
            capture_output=True, text=True,
        )
    except Exception as exc:
        print("could not launch zenity:", exc, file=sys.stderr)
        return 1
    if res.returncode != 0:
        print("cancelled.")
        return 1
    chosen = res.stdout.strip()
    if not chosen:
        print("no folder chosen.")
        return 1
    resp = client_request({"cmd": "set-config", "changes": {"output_dir": chosen}})
    if not resp.get("ok"):
        print("error:", resp.get("error"), file=sys.stderr)
        return 1
    print(f"output_dir = {chosen}")
    return 0


def cmd_set_dir(args):
    if args.gui or not args.path:
        return _pick_folder_and_set(use_gui=True)
    resp = client_request({"cmd": "set-config", "changes": {"output_dir": args.path}})
    if not resp.get("ok"):
        print("error:", resp.get("error"), file=sys.stderr)
        return 1
    print(f"output_dir = {resp['applied']['output_dir']}")
    return 0


def cmd_sources(args):
    pactl = which("pactl")
    if not pactl:
        print("pactl not found.", file=sys.stderr)
        return 1
    out = subprocess.run([pactl, "list", "sources", "short"],
                         capture_output=True, text=True)
    default = subprocess.run([pactl, "get-default-source"],
                             capture_output=True, text=True).stdout.strip()
    print(f"default source: {default}\n")
    print(out.stdout.rstrip())
    return 0


def cmd_cameras(args):
    """List available V4L2 camera devices."""
    devs = sorted(glob.glob("/dev/video*"),
                  key=lambda p: int(re.sub(r"\D", "", os.path.basename(p)) or 0))
    if not devs:
        print("no /dev/video* devices found.", file=sys.stderr)
        return 1
    try:
        cur = client_request({"cmd": "get-config"}).get("config", {})
        chosen = resolve_camera(cur)
    except DaemonError:
        chosen = resolve_camera(DEFAULT_CONFIG)
    print(f"default camera: {chosen}\n")
    v4l2 = which("v4l2-ctl")
    for dev in devs:
        label = ""
        if v4l2:
            r = subprocess.run([v4l2, "-d", dev, "--info"],
                               capture_output=True, text=True)
            m = re.search(r"Card type\s*:\s*(.+)", r.stdout)
            if m:
                label = "  " + m.group(1).strip()
        mark = " *" if dev == chosen else "  "
        print(f"{mark}{dev}{label}")
    return 0


def cmd_where(args):
    try:
        st = client_request({"cmd": "status"})
    except DaemonError as exc:
        print("error:", exc, file=sys.stderr)
        return 1
    print(st["output_dir"])
    return 0


def cmd_doctor(args):
    """Health check: dependencies, daemon, hotkeys, stealth prediction."""
    ok = True

    def check(label, good, detail=""):
        nonlocal ok
        mark = "\033[32m✓\033[0m" if good else "\033[31m✗\033[0m"
        print(f"  {mark} {label}" + (f"  — {detail}" if detail else ""))
        if not good:
            ok = False

    print("KeyRec doctor\n")
    check("ffmpeg installed", bool(which("ffmpeg")), which("ffmpeg") or "missing")
    check("pactl installed", bool(which("pactl")), which("pactl") or "missing")
    check("keyd installed", bool(which("keyd")), which("keyd") or "missing")
    cams = sorted(glob.glob("/dev/video*"))
    check("camera device present", bool(cams),
          ", ".join(cams) if cams else "no /dev/video* (video recording won't work)")
    check("zenity (GUI folder picker)", bool(which("zenity")),
          which("zenity") or "optional, missing")
    check("notify-send (notifications)", bool(which("notify-send")),
          which("notify-send") or "optional, missing")

    daemon_ok = False
    try:
        resp = client_request({"cmd": "ping"})
        daemon_ok = resp.get("ok", False)
        check("daemon reachable", daemon_ok, f"v{resp.get('version')}")
    except DaemonError as exc:
        check("daemon reachable", False, str(exc).splitlines()[0])

    if daemon_ok:
        st = client_request({"cmd": "status"})
        check("output folder writable",
              _dir_writable(st["output_dir"]), st["output_dir"])
        print(f"\n  audio hotkey  : {st['hotkey']}")
        print(f"  video hotkey  : {st['video_hotkey']}")
        print(f"  camera        : {st['camera']}")
        print(f"  mic volume    : {st['mic_volume']}%")
        print(f"  stealth       : {'on' if st['stealth'] else 'off'}")
        print(f"  notify        : {'on' if st.get('notify', True) else 'off'}")
        print(f"  audio state   : {'recording' if st['audio']['recording'] else 'idle'}")
        print(f"  video state   : {'recording' if st['video']['recording'] else 'idle'}")

    # keyd hotkey wiring present?
    payload = os.path.exists(KEYD_INCLUDE_FILE)
    included = any(
        _file_has_ids(p) and any(
            l.strip() == f"include {KEYD_INCLUDE_NAME}"
            for l in open(p, encoding="utf-8", errors="ignore"))
        for p in _keyd_conf_files()
    )
    check("keyd hotkey payload installed", payload, KEYD_INCLUDE_FILE)
    check("keyd hotkeys wired into a config", included,
          "run: sudo keyrec apply-hotkey" if not included else "")

    print("\n  note: a camera's activity LED is hardware-controlled and lights")
    print("        whenever video records — it cannot be hidden in software.")
    print()
    print("all good ✅" if ok else "some checks failed ⚠")
    return 0 if ok else 1


def _dir_writable(path):
    try:
        os.makedirs(path, exist_ok=True)
        return os.access(path, os.W_OK)
    except OSError:
        return False


def _reexec_root(subcmd):
    """Re-run this command under sudo (prompts in the terminal)."""
    self_path = os.environ.get("KEYREC_BIN") or os.path.abspath(sys.argv[0])
    print(f"'{subcmd}' needs root — re-running with sudo...")
    os.execvp("sudo", ["sudo", self_path, subcmd])


def cmd_apply_hotkey(args):
    """Write the keyd include payload and wire it into the keyboard configs."""
    if os.geteuid() != 0:
        _reexec_root("apply-hotkey")
        return 1  # not reached
    # Prefer the running daemon's effective config (it merges the right user
    # override regardless of whose home root's process sees); fall back to disk.
    cfg = None
    try:
        cfg = client_request({"cmd": "get-config"}).get("config")
    except Exception:
        pass
    if not cfg:
        cfg = load_config()
    bindings = [
        (cfg["hotkey"], _toggle_cmd("audio")),
        (cfg["video_hotkey"], _toggle_cmd("video")),
    ]
    try:
        content = render_keyd_include(bindings)
    except ValueError as exc:
        print("error:", exc, file=sys.stderr)
        return 1
    os.makedirs(KEYD_DIR, exist_ok=True)
    with open(KEYD_INCLUDE_FILE, "w", encoding="utf-8") as fh:
        fh.write(content)
    os.chmod(KEYD_INCLUDE_FILE, 0o644)
    print(f"wrote {KEYD_INCLUDE_FILE}")
    wired = 0
    for path in _keyd_conf_files():
        if not _file_has_ids(path):
            continue
        status = _insert_include(path)
        print(f"  {os.path.basename(path)}: {status}")
        if status in ("added", "already"):
            wired += 1
    if wired == 0:
        print("  ! no keyd config with an [ids] section found to include into.")
        print("    Add `include keyrec` after the [ids] line of your keyd config,")
        print("    or create /etc/keyd/default.conf with:  [ids]\\n*")
    _keyd_reload()
    print(f"keyd reloaded — {cfg['hotkey']} toggles audio, "
          f"{cfg['video_hotkey']} toggles video.")
    return 0


def cmd_unbind_hotkey(args):
    """Remove the keyd include payload and the include lines (for uninstall)."""
    if os.geteuid() != 0:
        _reexec_root("unbind-hotkey")
        return 1
    for path in _keyd_conf_files():
        st = _remove_include(path)
        if st == "removed":
            print(f"  {os.path.basename(path)}: include removed")
    try:
        os.remove(KEYD_INCLUDE_FILE)
        print(f"removed {KEYD_INCLUDE_FILE}")
    except OSError:
        pass
    _keyd_reload()
    print("hotkeys unbound.")
    return 0


def cmd_notify(args):
    """Turn the start/stop desktop notifications on or off (or toggle)."""
    action = (args.state or "toggle").lower()
    if action in ("on", "true", "yes", "enable", "enabled", "1"):
        val = True
    elif action in ("off", "false", "no", "disable", "disabled", "0"):
        val = False
    elif action == "toggle":
        try:
            cur = client_request({"cmd": "get-config"}).get("config", {}).get("notify", True)
        except DaemonError as exc:
            print("error:", exc, file=sys.stderr)
            return 1
        val = not bool(cur)
    else:
        print("usage: keyrec notify [on|off|toggle]", file=sys.stderr)
        return 1
    resp = client_request({"cmd": "set-config", "changes": {"notify": val}})
    if not resp.get("ok"):
        print("error:", resp.get("error"), file=sys.stderr)
        return 1
    print(f"notifications {'on' if val else 'off'}")
    return 0


def cmd_version(args):
    print(f"KeyRec {VERSION}")
    return 0


# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(
        prog="keyrec",
        description="Hotkey-toggled microphone + camera recorder for Linux/GNOME.",
    )
    p.add_argument("--version", action="store_true", help="print version and exit")
    sub = p.add_subparsers(dest="command")

    sub.add_parser("daemon", help="run the recording daemon (used by systemd)")

    def _add_target(sp):
        sp.add_argument("target", nargs="?", default="audio",
                        choices=["audio", "video"],
                        help="which recorder to act on (default: audio)")
        sp.add_argument("--quiet", action="store_true")
        sp.add_argument("--source", default=None, help=argparse.SUPPRESS)  # e.g. hotkey

    _add_target(sub.add_parser("toggle", help="start/stop a recorder (audio|video)"))
    _add_target(sub.add_parser("start", help="start a recorder (audio|video)"))
    _add_target(sub.add_parser("stop", help="stop a recorder (audio|video)"))

    sp = sub.add_parser("status", help="show current recording state")
    sp.add_argument("--json", action="store_true", help="machine-readable output")

    sp = sub.add_parser("config", help="view or change configuration")
    csub = sp.add_subparsers(dest="config_action")
    g = csub.add_parser("get", help="print config (optionally one KEY)")
    g.add_argument("key", nargs="?")
    s = csub.add_parser("set", help="set KEY to VALUE")
    s.add_argument("key")
    s.add_argument("value")
    csub.add_parser("path", help="pick the recordings folder with a GUI dialog")

    sp = sub.add_parser("set-dir", help="set the recordings folder (path or --gui)")
    sp.add_argument("path", nargs="?")
    sp.add_argument("--gui", action="store_true", help="use the GUI folder picker")

    sp = sub.add_parser("notify",
                        help="turn start/stop notifications on|off (no arg = toggle)")
    sp.add_argument("state", nargs="?", help="on | off | toggle (default: toggle)")

    sub.add_parser("sources", help="list available microphone sources")
    sub.add_parser("cameras", help="list available camera devices")
    sub.add_parser("where", help="print the recordings folder")
    sub.add_parser("doctor", help="run health checks")
    sub.add_parser("apply-hotkey",
                   help="(re)install the keyd hotkey bindings (uses sudo)")
    sub.add_parser("unbind-hotkey",
                   help="remove the keyd hotkey bindings (uses sudo)")
    sub.add_parser("version", help="print version")

    return p


DISPATCH = {
    "daemon": cmd_daemon,
    "toggle": cmd_toggle,
    "start": cmd_start,
    "stop": cmd_stop,
    "status": cmd_status,
    "config": cmd_config,
    "set-dir": cmd_set_dir,
    "notify": cmd_notify,
    "sources": cmd_sources,
    "cameras": cmd_cameras,
    "where": cmd_where,
    "doctor": cmd_doctor,
    "apply-hotkey": cmd_apply_hotkey,
    "unbind-hotkey": cmd_unbind_hotkey,
    "version": cmd_version,
}


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.version:
        return cmd_version(args)
    if not args.command:
        parser.print_help()
        return 1
    handler = DISPATCH.get(args.command)
    if not handler:
        parser.print_help()
        return 1
    try:
        return handler(args)
    except DaemonError as exc:
        print("error:", exc, file=sys.stderr)
        return 1
    except BrokenPipeError:
        return 0
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
